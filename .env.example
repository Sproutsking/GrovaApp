# Public browser configuration (CRA embeds REACT_APP_* values in built assets)
REACT_APP_SUPABASE_URL=https://<project-ref>.supabase.co
REACT_APP_SUPABASE_ANON_KEY=<supabase-anon-key>
REACT_APP_CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
REACT_APP_CLOUDINARY_API_KEY=<cloudinary-api-key>
REACT_APP_CLOUDINARY_UPLOAD_PRESET=<unsigned-upload-preset>
REACT_APP_VAPID_PUBLIC_KEY=<vapid-public-key>
REACT_APP_R2_PUBLIC_URL=<public-r2-url>
REACT_APP_ONESIGNAL_APP_ID=<onesignal-app-id>

# Server/edge-function secrets: never prefix these with REACT_APP_
CLOUDINARY_API_SECRET=<cloudinary-api-secret>
VAPID_PRIVATE_KEY=<vapid-private-key>
TWO_FA_ENCRYPTION_KEY=<two-factor-encryption-key>
RESEND_API_KEY=<resend-api-key>
PAYSTACK_SECRET_KEY=<paystack-secret-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>